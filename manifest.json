{
  "manifest_version": 3,
  "name": "B站动态分组",
  "version": "0.1.1",
  "description": "在顶栏「动态」弹窗里，按关注分组 / 视频分区 / UP主 筛选最近几天的动态。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
